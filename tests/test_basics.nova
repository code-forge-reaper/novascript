// tests/test_basics.nova — literals, variables, operators, strings

// --- Literals & variables ---
var n = 42
var f = 3.14
var s = "hello"
var b = true
var z = nil
var nan = NaN

assert n == 42, "int literal"
assert f > 3.0, "float literal"
assert s == "hello", "string literal"
assert b == true, "bool true"
assert z == nil, "nil"
assert nan != nan, "NaN is not equal to itself"

const C = 100
assert C == 100, "const"

var typed string = "ok"
assert typed == "ok", "typed var"

// --- Arithmetic ---
assert 1 + 2 == 3, "add"
assert 10 - 3 == 7, "sub"
assert 4 * 5 == 20, "mul"
assert 20 / 4 == 5, "div"
assert 10 % 3 == 1, "mod"

// --- Comparison ---
assert 5 > 3, "gt"
assert 3 < 5, "lt"
assert 5 >= 5, "ge"
assert 3 <= 3, "le"
assert 1 == 1, "eq"
assert 1 != 2, "ne"

// --- Logical ---
assert true && true, "and true"
assert !(true && false), "and false"
assert true || false, "or"
assert !false, "not"

// --- Compound assignment on variables ---
var x = 10
x += 5
assert x == 15, "var +="
x -= 3
assert x == 12, "var -="
x *= 2
assert x == 24, "var *="
x /= 4
assert x == 6, "var /="
x %= 4
assert x == 2, "var %="

// --- Strings ---
assert "a" + "b" == "ab", "string concat"
var fmt = "val={}".format(42)
assert fmt == "val=42", "string format"

// --- Bitwise (from example) ---
assert (2 | 4) == 6, "bitwise or"
assert (2 ^ 8) == 10, "bitwise xor"
assert (16 << 2) == 64, "left shift"
assert (8 >> 2) == 2, "right shift"

print("test_basics: OK")
