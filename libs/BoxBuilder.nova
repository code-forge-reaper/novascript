// novascript/libs/BoxBuilder
// this is the most hacky lib i ever made
//
// extensible box drawing. everything the library does is a "handler":
// a {compute, render} pair registered against a numeric type.
// the four built-in Api_Handlers below are the same shape as any you add.
// to extend, register a handler and push an instruction with its type:
//
//     bb = load("BoxBuilder")
//     bb.Api_Handlers[42] = {
//         compute: func(instr, ctx) ctx.local_max = math.max(ctx.local_max, instr.width) end,
//         render:  func(instr, ctx) ctx.rendered_lines.append(bb.adjust(instr.line, ctx.max_width)) end
//     }
//     bb.newInstruction({type: 42, line: "hello"})

const mlib = load("helperlib")
const sys  = load("py:sys")
/*
my entire reason for making this, is for a stupid bit in a web story i was writting,
it was meant for like, one, maybe two scenes, that's it
(that's also why half the math looks drunkinly put toggether).
Just gonna leave this in novascript's included lib so i can re-use it sometime later.
*/


// === extension registry ===

define Handler = {
    compute: function,
    render: function
}

// nova validates against `Handler` on assignment.
// keys are ints; use InstrType.* or your own.
export const Api_Handlers = {}

// not an enum, so third-party types don't collide with ours
const InstrType = {
    Text: 0
    Centered: 1
    Newline: 2
    Box: 3
}
export func GetApiHandler(type int)
    var c Handler = Api_Handlers[type]
    return c
end
export func RegisterHandler(type int, handler Handler)
    Api_Handlers[type] = handler
end

// === primitives ===
// Api_Handlers (built-in or otherwise) render into these.

export const PADDING = 4

export const ASCII = {
    TL: "┌", TR: "┐",
    BL: "└", BR: "┘",
    H:  "─",
    V:  "│",
            MT: "┬",
    LT: "├", CR: "┼", RT: "┤",
            MB: "┴"
}

export func Border(left, right, width)
    return left + ASCII.H * (width - 2) + right
end
export func Center(text, width)
    var remaining = width - #text
    if remaining < 0 return text end
    var left = math.floor(remaining / 2)
    return " " * left + text + " " * (remaining - left)
end

export func adjust(s string, width)
    return ASCII.V + " " + s.ljust(width) + " " + ASCII.V
end

export func flushLine(ctx)
    ctx.rendered_lines.append(adjust(ctx.current_line, ctx.max_width))
    ctx.current_line = ""
end


// === core ===
// state is a plain dict. the stack is the only mutable global.
export func newState()
    return {instructions: [], max_width: 0}
end
export func compute_max_width()
    var ctx = {current_line: "", local_max: 0}

    for instr in topBox().instructions do
        GetApiHandler(instr.type).compute(instr, ctx)
    end

    if ctx.current_line
        ctx.local_max = math.max(ctx.local_max, #ctx.current_line)
    end
    return ctx.local_max
end

export func RenderBox()
    var state = topBox()
    state.max_width = math.max(compute_max_width(), 6)

    var box_width = state.max_width + PADDING

    var ctx = {
        current_line: "",
        rendered_lines: [Border(ASCII.TL, ASCII.TR, box_width)],
        max_width: state.max_width,
        sep_border: Border(ASCII.LT, ASCII.RT, box_width)
    }

    for instr in state.instructions do
        GetApiHandler(instr.type).render(instr, ctx)
    end

    if ctx.current_line
        flushLine(ctx)
    end

    ctx.rendered_lines.append(Border(ASCII.BL, ASCII.BR, box_width))

    var out = "\n".join(ctx.rendered_lines)

    state.instructions.clear()
    state.max_width = 0

    return out
end


// === stack ===

const stack = []

export func topBox() return stack[#stack - 1] end
export func push(box) stack.append(box) end
export func pop() stack.pop() end


// === built-in Api_Handlers ===
// these are the same shape as third-party extensions.

Api_Handlers[InstrType.Text] = {
    compute: func(instr, ctx)
        ctx.current_line += instr.content
    end,
    render: func(instr, ctx)
        ctx.current_line += instr.content
    end
}

Api_Handlers[InstrType.Centered] = {
    compute: func(instr, ctx)
        ctx.current_line += instr.content
    end,
    render: func(instr, ctx)
        ctx.current_line += Center(instr.content, ctx.max_width)
    end
}

Api_Handlers[InstrType.Box] = {
    compute: func(instr, ctx)
        ctx.local_max = math.max(ctx.local_max, #ctx.current_line)
        ctx.current_line = ""
        ctx.local_max = math.max(ctx.local_max, instr.width)
    end,
    render: func(instr, ctx)
        if ctx.current_line
            flushLine(ctx)
        end
        for line in instr.lines do
            ctx.rendered_lines.append(adjust(line, ctx.max_width))
        end
    end
}

Api_Handlers[InstrType.Newline] = {
    compute: func(instr, ctx)
        ctx.local_max = math.max(ctx.local_max, #ctx.current_line)
        ctx.current_line = ""
    end,
    render: func(instr, ctx)
        flushLine(ctx)
        if instr.sep
            ctx.rendered_lines.append(ctx.sep_border)
        end
    end
}


// === instruction API ===
// sugar over `newInstruction`. each built-in handler gets a thin wrapper.

export func newInstruction(inst)
    topBox().instructions.append(inst)
end

export func AddText(content)
    newInstruction({type: InstrType.Text, content})
end

export func AddCentered(content, sep = false)
    newInstruction({type: InstrType.Centered, content})
    NewLine(sep)
end

export func NewLine(sep = false)
    newInstruction({type: InstrType.Newline, sep})
end

export func Sep() NewLine(true) end

export func AddLine(text, sep = false)
    AddText(text)
    NewLine(sep)
end

export func AddSpacer()
    NewLine(false)
end

export func AddMultiline(text)
    for line in text.split("\n") do
        AddLine(line)
    end
end

export func EndBox(printTo = sys.stdout)
    write(RenderBox(), printTo)
end


// === standalone helpers ===

export func Bar(current, max, maxWidth=0, display="#", empty="*")
    if maxWidth == 0
        current = math.min(current, max)
        return display * current + empty * (max - current)
    else
        current = mlib.clamp(current, 0, max)
        var filled = math.floor((current / max) * maxWidth)
        return display * filled + empty * (maxWidth - filled)
    end
end

export func CheckBox(txt, check = false)
    if check return("[x] - " + txt) else return("[ ] - " + txt) end
end

export func Indent(text, spaces = 2)
    var pad = " " * spaces
    var out = []
    for line in text.split("\n") do
        out.append(pad + line)
    end
    return "\n".join(out)
end


// === composite builders ===

export func Box(items, prepend = "")
    var inner = newState()
    push(inner)
    defer pop() end

    for item in items do
        if Is.string(item) && Has.inside(item, "\n")
            for line in item.split("\n") do
                AddLine(prepend + line)
            end
        elseif Is.dict(item) && item.type
            newInstruction(item)
        else
            AddLine(prepend + Convert.toStr(item))
        end
    end

    var rendered = RenderBox()
    var lines = rendered.split("\n")
    var max_width = 0
    for line in lines do
        max_width = math.max(max_width, #line)
    end

    return {
        type: InstrType.Box,
        lines: lines,
        width: max_width
    }
end

export func BoxStr(items, prepend="") = topBox().instructions.append(Box(items, prepend))

export func Table(props)
    var col_names = []
    var col_widths = []
    var max_rows = 0

    for key in props do
        col_names.append(key)
        var rows = props[key]
        var max_len = #key
        for row in rows do
            max_len = math.max(max_len, #row)
        end
        col_widths.append(max_len)
        max_rows = math.max(max_rows, #rows)
    end

    func border_line(left, mid, right)
        var line = left
        for i = 0, #col_names - 1 do
            line += ASCII.H * (col_widths[i] + 2)
            if i < #col_names - 1
                line += mid
            end
        end
        line += right
        return line
    end

    var out = ""
    out += border_line(ASCII.TL, ASCII.MT, ASCII.TR) + "\n"

    var header = ASCII.V
    for i = 0, #col_names - 1 do
        header += " " + col_names[i].ljust(col_widths[i]) + " " + ASCII.V
    end
    out += header + "\n"
    out += border_line(ASCII.LT, ASCII.CR, ASCII.RT) + "\n"

    for r = 0, max_rows - 1 do
        var row = ASCII.V
        for i = 0, #col_names - 1 do
            var rows = props[col_names[i]]
            var cell = ""
            if r < #rows cell = rows[r] end
            row += " " + cell.ljust(col_widths[i]) + " " + ASCII.V
        end
        out += row + "\n"
    end

    out += border_line(ASCII.BL, ASCII.MB, ASCII.BR)

    return out
end


// === self-test ===

if __IS_MAIN__
    push(newState())
    AddText("Status")
    Sep()
    AddLine("hello, world", true)
    AddLine(Bar(5,20))
    AddText("shit to buy") BoxStr([
        "Wine", "Sugar","Salt", Box([
            "Rice",
            "Vinegar"
        ], "* ")
    ], "() ")
    Table({
        cool: ["this should", "scale automaticaly", "not be best, but not the worst"],
        ideas: ["another", "double pass", "system"]
    }) -> AddMultiline
    EndBox()
end
